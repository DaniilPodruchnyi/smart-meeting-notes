# SaluteSpeech
SALUTE_SPEECH_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
SALUTE_SPEECH_AUTHORIZATION_KEY=
SALUTE_SPEECH_SCOPE=SALUTE_SPEECH_PERS
SALUTE_SPEECH_API_BASE_URL=https://smartspeech.sber.ru/rest/v1
SALUTE_SPEECH_UPLOAD_PATH=/data:upload
SALUTE_SPEECH_RECOGNIZE_PATH=/speech:async_recognize
SALUTE_SPEECH_STATUS_PATH=/task:get
SALUTE_SPEECH_DOWNLOAD_PATH=/data:download
SALUTE_SPEECH_MODEL=general
SALUTE_SPEECH_LANGUAGE=ru-RU
SALUTE_SPEECH_AUDIO_ENCODING=PCM_S16LE
SALUTE_SPEECH_SAMPLE_RATE=16000
SALUTE_SPEECH_CHANNELS_COUNT=1
SALUTE_SPEECH_POLL_INTERVAL=2s
SALUTE_SPEECH_POLL_TIMEOUT=2m
SALUTE_SPEECH_HTTP_TIMEOUT=30s