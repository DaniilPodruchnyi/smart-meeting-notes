HTTP_ADDRESS=:8080
LOG_LEVEL=info

# TELEGRAM_BOT_TOKEN=

# GigaChat (OAuth тот же шлюз, что и для SaluteSpeech; ключ — Authorization Key из Studio)
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_AUTHORIZATION_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_API_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_CHAT_COMPLETIONS_PATH=/chat/completions
GIGACHAT_EMBEDDINGS_PATH=/embeddings
GIGACHAT_EMBEDDINGS_MODEL=Embeddings
# Опционально для лучшего retrieval (см. доку GigaChat «векторное представление»):
# GIGACHAT_EMBEDDINGS_QUERY_PREFIX=Given the question, find a paragraph with the answer \nquestion:
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_TEMPERATURE=0.7
GIGACHAT_TOP_P=0
GIGACHAT_MAX_TOKENS=1024
GIGACHAT_HTTP_TIMEOUT=60s

# SaluteSpeech
SALUTE_SPEECH_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
SALUTE_SPEECH_AUTHORIZATION_KEY=
SALUTE_SPEECH_SCOPE=SALUTE_SPEECH_PERS
SALUTE_SPEECH_API_BASE_URL=https://smartspeech.sber.ru/rest/v1
SALUTE_SPEECH_UPLOAD_PATH=/data:upload
SALUTE_SPEECH_RECOGNIZE_PATH=/speech:async_recognize
SALUTE_SPEECH_STATUS_PATH=/task:get
SALUTE_SPEECH_DOWNLOAD_PATH=/data:download
SALUTE_SPEECH_MODEL=general
SALUTE_SPEECH_LANGUAGE=ru-RU
SALUTE_SPEECH_AUDIO_ENCODING=MP3
SALUTE_SPEECH_SAMPLE_RATE=44100
SALUTE_SPEECH_CHANNELS_COUNT=1
SALUTE_SPEECH_POLL_INTERVAL=2s
SALUTE_SPEECH_POLL_TIMEOUT=2m
SALUTE_SPEECH_HTTP_TIMEOUT=30s

